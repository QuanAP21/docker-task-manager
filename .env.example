# Copy file này thành .env trước khi chạy Docker Compose.
# Development có thể đặt DJANGO_DEBUG=1. Production nên đặt DJANGO_DEBUG=0.
POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpassword
DB_HOST=db
DB_PORT=5432
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
